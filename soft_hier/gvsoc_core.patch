+// This gets called when the mempool trace csr (0x7d0) is accessed.
+// mempool_start_benchmark() writes 1 to open a region of interest, mempool_stop_benchmark()
+// writes 0 to close it, at which point we report how long the region took.
+bool Iss::bench_csr_update(bool is_write, iss_reg_t &value)
+{
+    if (!is_write)
+    {
+        return true;
+    }
+
+    if (value != 0)
+    {
+        this->bench_start_cycles = this->top.clock.get_cycles();
+        this->bench_start_time = this->top.time.get_time();
+        this->bench_active = true;
+    }
+    else if (this->bench_active)
+    {
+        int64_t end_cycles = this->top.clock.get_cycles();
+        int64_t end_time = this->top.time.get_time();
+
+        printf("[BENCH] cycles=%" PRId64 " ns=%" PRId64 " start=%" PRId64 " end=%" PRId64
+            " region=%u hart=%d path=%s\n",
+            end_cycles - this->bench_start_cycles,
+            (end_time - this->bench_start_time) / 1000,
+            this->bench_start_cycles, end_cycles,
+            this->bench_region++, (int)this->csr.mhartid,
+            this->top.get_path().c_str());
+
+        this->bench_active = false;
+    }
+
+    return true;
+}
+
+
